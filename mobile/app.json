{
  "expo": {
    "name": "SilicaGuard",
    "slug": "SilicaGuard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EFF6FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.silicaguard.app"
    },
    "android": {
      "package": "com.silicaguard.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EFF6FF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "23c1340e-0e32-44de-8175-0b01c661193c"
      }
    },
    "owner": "teekay001",
    "plugins": [
      "expo-font"
    ]
  }
}
