# Gemini API key — powers all four AI modules (see CLAUDE.md). Get one at aistudio.google.com.
GEMINI_API_KEY=AIza...

# Claude API key — documented drop-in alternative to Gemini if Anthropic billing becomes
# available (see CLAUDE.md tech stack). Not currently read by any code path.
ANTHROPIC_API_KEY=sk-ant-...

# Africa's Talking API key — used for both USSD and SMS, called via httpx (not their SDK).
AT_API_KEY=atsk_...
# Africa's Talking username. "sandbox" for the free sandbox; your live username in production.
AT_USERNAME=sandbox
# Phone number that receives hospital pre-alert SMS when a referral is created.
HOSPITAL_NURSE_PHONE=+263...

# Demo-only email pre-alert — a second channel alongside the SMS pre-alert
# above, sent for every ORANGE/RED referral, and also re-fireable on demand
# via POST /api/referrals/notify-email (see routers/dashboard.py). Not the
# same thing as HOSPITAL_EMAIL below (that's the dashboard login username).
#
# 12 August: sent via Resend's HTTP API, not Gmail SMTP — Render's free
# tier blocks outbound SMTP entirely (confirmed live: every smtplib attempt
# failed with "OSError: Network is unreachable"), same class of problem
# services/notifications.py already solved for SMS by calling Africa's
# Talking's REST API directly instead of a lower-level protocol.
#
# Get a key at resend.com (free, no domain needed to send to your own
# signup address). Without a verified domain RESEND_FROM_EMAIL must stay
# the default onboarding@resend.dev, and EMAIL_TO must be the address you
# signed up with.
RESEND_API_KEY=re_...
# Optional — defaults to "SilicaGuard <onboarding@resend.dev>". Only
# usable with a real value once a sending domain is verified on Resend.
RESEND_FROM_EMAIL=SilicaGuard <onboarding@resend.dev>
# Recipient — standing in for a real hospital inbox for now, per CLAUDE.md.
# Falls back to EMAIL_ADDRESS if unset (kept for backward compatibility).
EMAIL_TO=you@gmail.com

# A full SQLAlchemy engine URL — NOT a bare file path anymore (that was the
# pre-14-August-2026 format, before the SQLAlchemy ORM migration). Default
# below is local SQLite. For Supabase Postgres in production, use something
# like: postgresql+psycopg://user:password@host:5432/postgres
DATABASE_URL=sqlite:///./data/silicaguard.db
# Secret used to sign JWT auth tokens. Use a long random value in any non-local environment.
SECRET_KEY=your-jwt-secret-key-here
# development | production — currently informational only, not branched on in code.
ENVIRONMENT=development

# Demo dashboard login (MVP has no users table — see CLAUDE.md sprint status).
# Target v4.0 roles are practitioner/clinical; these are pre-v4.0 hospital/cimas roles.
HOSPITAL_EMAIL=hospital@silicaguard.health
HOSPITAL_PASSWORD=change-me
CIMAS_EMAIL=cimas@silicaguard.health
CIMAS_PASSWORD=change-me

# Smart Referral Router reminder/escalation cascade + Outreach Planner
# announcement cadence (in-process APScheduler jobs, see main.py). "false"
# disables both entirely — tests/conftest.py sets this automatically so
# pytest never starts a background thread.
SCHEDULER_ENABLED=true
# How often both scheduled jobs run, in minutes.
SCHEDULER_INTERVAL_MINUTES=10

# "true" re-runs scripts/seed_demo_data.py on every boot, wiping and
# reseeding every table the script owns. Was "true" in production while the
# DB was SQLite on Render's free tier (no persistent disk — state reset on
# every redeploy/sleep-wake anyway, so reseeding was the only way to avoid
# booting into an empty DB). Postgres via Supabase (Step B, 15 August 2026)
# is persistent, so production now runs this "false" — reseeding on every
# boot would destroy real referral-code confirmations and screenings
# between rehearsals. Leave "false" for local dev too; reseed manually when
# you actually want a known-good reset.
AUTO_SEED_ON_BOOT=false
